<Layouts.app flash={@flash} current_scope={%{}} variant={:participant}>
  <section
    id="consent-declined"
    class="mx-auto max-w-xl rounded-3xl border border-slate-200 bg-white p-8 shadow-xl shadow-slate-900/5 transition-colors dark:border-slate-700 dark:bg-slate-900 dark:shadow-black/20 sm:p-12"
  >
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">
      Consent declined
    </p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 dark:text-white">
      No study data was saved
    </h1>
    <p class="mt-5 leading-7 text-slate-600 dark:text-slate-300">
      Return this submission from your Prolific submissions page. You may now close this tab.
    </p>
    <a
      id="return-to-prolific"
      href="https://app.prolific.com/submissions"
      class="mt-8 inline-flex items-center rounded-xl bg-slate-900 px-5 py-3 font-semibold text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:bg-indigo-600 dark:hover:bg-indigo-500 dark:focus:ring-offset-slate-900"
    >
      Open Prolific submissions
    </a>
  </section>
</Layouts.app>
