<Layouts.app flash={@flash} current_scope={%{}} variant={:participant}>
  <section
    id="participation-entry-error"
    class="mx-auto max-w-xl rounded-3xl border border-slate-200 bg-white p-8 shadow-xl shadow-slate-900/5 transition-colors dark:border-slate-700 dark:bg-slate-900 dark:shadow-black/20 sm:p-12"
  >
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-rose-700">Unable to start</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 dark:text-white">
      This study link could not be verified
    </h1>
    <p class="mt-5 leading-7 text-slate-600 dark:text-slate-300">
      Please return to Prolific and open the study from your submissions page. If the problem continues, contact the researcher through Prolific.
    </p>
    <p class="mt-6 rounded-xl bg-slate-100 px-4 py-3 text-sm text-slate-600 dark:bg-slate-800 dark:text-slate-300">
      Reference: {entry_error_reference(@reason)}
    </p>
  </section>
</Layouts.app>
