<Layouts.app flash={@flash} current_scope={%{}} variant={:participant}>
  <section
    id="dev-prolific-complete"
    class="mx-auto max-w-xl rounded-3xl border border-emerald-200 bg-white p-8 shadow-xl shadow-slate-900/5 transition-colors dark:border-emerald-900 dark:bg-slate-900 dark:shadow-black/20 sm:p-12"
  >
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-emerald-700">
      Local Prolific stand-in
    </p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 dark:text-white">
      The development run is complete
    </h1>
    <p class="mt-5 leading-7 text-slate-600 dark:text-slate-300">
      Production redirects to Prolific. Development stays local so you can inspect the completed participation and export.
    </p>
    <p
      :if={@completion_code}
      id="dev-completion-code"
      class="mt-6 rounded-xl bg-slate-100 px-4 py-3 font-mono text-sm text-slate-700 dark:bg-slate-800 dark:text-slate-200"
    >
      Completion code: {@completion_code}
    </p>
  </section>
</Layouts.app>
